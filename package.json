{
    "name": "@ts-core/backend-nestjs-language",
    "version": "11.0.2",
    "description": "NestJS module for internationalization (i18n) of backend applications: loads translations from files and serves them to clients with caching",
    "scripts": {},
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js"
        }
    },
    "license": "ISC",
    "dependencies": {
        "@nestjs/swagger": "^11.2.0",
        "@ts-core/language": "~3.0.36",
        "@ts-core/backend-nestjs": "~11.0.1"
    },
    "devDependencies": {
        "gulp-npm-module-publisher": "^3.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/ts-core-backend-nestjs-language.git"
    },
    "keywords": [
        "typescript",
        "nestjs",
        "i18n",
        "internationalization",
        "localization",
        "translation",
        "language",
        "locale",
        "backend",
        "cache"
    ],
    "bugs": {
        "url": "https://github.com/ManhattanDoctor/ts-core-backend-nestjs-language/issues"
    },
    "homepage": "https://github.com/ManhattanDoctor/ts-core-backend-nestjs-language#readme"
}
